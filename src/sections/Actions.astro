---
import Card from '@/components/Card.astro';
import Container from '@/components/Container.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { ACTION_GROUPS, ACTIONS_SECTION, CONFIRM_MOCKUP, SCREEN_FEATURE } from '@/data/actions';
---

<section id="acciones" aria-labelledby={ACTIONS_SECTION.id} class="py-section lg:py-section-lg">
  <Container class="flex flex-col gap-12">
    <SectionHeading
      id={ACTIONS_SECTION.id}
      eyebrow={ACTIONS_SECTION.eyebrow}
      title={ACTIONS_SECTION.title}
      intro={ACTIONS_SECTION.intro}
    />

    <div class="grid gap-6 lg:grid-cols-3">
      {ACTION_GROUPS.map((group) => (
        <Card as="article">
          <h3 class="font-display text-title-3 font-bold text-foreground">{group.title}</h3>
          <ul class="mt-4 flex flex-col gap-3">
            {group.items.map((item) => (
              <li class="flex items-start gap-3 text-small text-muted">
                <Icon name={item.icon} size={20} class="mt-0.5 shrink-0 text-emerald" />
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </Card>
      ))}
    </div>

    <div class="grid items-center gap-6 lg:grid-cols-2">
      <Card variant="featured" as="article">
        <Icon name={SCREEN_FEATURE.icon} size={32} class="text-emerald" />
        <p class="mt-4 font-mono text-label uppercase tracking-label text-emerald">
          {SCREEN_FEATURE.eyebrow}
        </p>
        <h3 class="mt-2 font-display text-title-3 font-bold text-foreground">
          {SCREEN_FEATURE.title}
        </h3>
        <p class="mt-2 text-body text-muted">{SCREEN_FEATURE.body}</p>
      </Card>

      <div aria-hidden="true" class="flex flex-col gap-3">
        <div class="mx-auto w-full max-w-md rounded-card border border-border bg-panel-raised p-5 shadow-glow">
          <div class="flex items-center gap-2 text-emerald">
            <Icon name="shield" size={20} />
            <span class="font-mono text-label uppercase tracking-label">
              {CONFIRM_MOCKUP.title}
            </span>
          </div>
          <p class="mt-3 text-small text-foreground">{CONFIRM_MOCKUP.description}</p>
          <div class="mt-5 flex gap-3">
            <span class="rounded-button border border-emerald bg-emerald/10 px-4 py-2 font-mono text-label text-emerald">
              {CONFIRM_MOCKUP.confirm}
            </span>
            <span class="rounded-button border border-border px-4 py-2 font-mono text-label text-muted">
              {CONFIRM_MOCKUP.cancel}
            </span>
          </div>
          <p class="mt-4 font-mono text-label text-muted">{CONFIRM_MOCKUP.note}</p>
        </div>
      </div>
    </div>
    <p class="text-center text-small text-muted">{CONFIRM_MOCKUP.caption}</p>
  </Container>
</section>
