---
import Badge from '@/components/Badge.astro';
import Card from '@/components/Card.astro';
import Container from '@/components/Container.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { INSTANT } from '@/data/instant';
---

<section id="instantaneas" aria-labelledby="instantaneas-title" class="py-section lg:py-section-lg">
  <Container class="flex flex-col gap-12">
    <div class="flex flex-col items-start gap-4">
      <Badge tone="accent" icon="bolt">
        {INSTANT.badge}
      </Badge>
      <SectionHeading
        id="instantaneas-title"
        eyebrow={INSTANT.eyebrow}
        title={INSTANT.title}
        intro={INSTANT.intro}
      />
    </div>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {INSTANT.commands.map((command) => (
        <Card as="li" class="flex items-center gap-4 p-4">
          <Icon name={command.icon} size={28} class="text-emerald" />
          <span class="font-display text-foreground">{command.label}</span>
        </Card>
      ))}
    </ul>
  </Container>
</section>
