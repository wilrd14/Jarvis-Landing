---
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import Container from '@/components/Container.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { AUTHOR } from '@/data/author';
import { SITE } from '@/data/site';
---

<section id="autor" aria-labelledby="autor-title" class="py-section lg:py-section-lg">
  <Container>
    <SectionHeading id="autor-title" eyebrow={AUTHOR.eyebrow} title={AUTHOR.title} />
    <Card class="mt-12 flex max-w-3xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-2">
        <p class="text-body text-muted">{AUTHOR.madeBy}</p>
        <p class="font-display text-title-3 font-bold text-foreground">{SITE.author}</p>
        <p class="text-body text-muted">{AUTHOR.role}</p>
      </div>
      <Button variant="secondary" href={SITE.portfolioUrl} external icon="external">
        {AUTHOR.portfolioLabel}
      </Button>
    </Card>
  </Container>
</section>
