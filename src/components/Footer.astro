---
import Container from '@/components/Container.astro';

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  name: string;
  logoSrc: string;
  links: readonly FooterLink[];
  navLabel: string;
  year: number;
  madeByLabel: string;
  author: string;
}

const { name, logoSrc, links, navLabel, year, madeByLabel, author } = Astro.props;
---

<footer class="border-border border-t py-12">
  <Container class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
    <div class="font-display text-title-3 text-foreground flex items-center gap-3 font-bold">
      <img src={logoSrc} alt="" width="32" height="32" class="rounded-pill size-8" />
      <span>{name}</span>
    </div>

    <nav aria-label={navLabel}>
      <ul class="flex flex-wrap gap-x-2 gap-y-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-button text-small text-muted hover:text-foreground inline-flex min-h-11 items-center px-3 underline underline-offset-4"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="text-small text-muted">
      © {year} {name} · {madeByLabel}
      {author}
    </p>
  </Container>
</footer>
