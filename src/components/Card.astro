---
interface Props {
  variant?: 'normal' | 'featured';
  /** Etiqueta HTML de la tarjeta. */
  as?: 'div' | 'article' | 'li';
  class?: string;
}

const { variant = 'normal', as: Tag = 'div', class: className, ...rest } = Astro.props;
const featured = variant === 'featured';
const corner = 'pointer-events-none absolute size-3 border-spark';
---

<Tag
  class:list={[
    'group relative rounded-card border p-6 transition-colors',
    featured
      ? 'border-emerald bg-panel-raised shadow-glow'
      : 'border-border bg-panel hover:border-emerald hover:shadow-glow',
    className,
  ]}
  {...rest}
>
  <span aria-hidden="true" class:list={[corner, 'left-2 top-2 border-l border-t']}></span>
  <span aria-hidden="true" class:list={[corner, 'right-2 top-2 border-r border-t']}></span>
  <span aria-hidden="true" class:list={[corner, 'bottom-2 left-2 border-b border-l']}></span>
  <span aria-hidden="true" class:list={[corner, 'bottom-2 right-2 border-b border-r']}></span>
  <slot />
</Tag>
