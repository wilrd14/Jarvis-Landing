---
interface Props {
  /** Etiqueta HTML del contenedor. */
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['mx-auto w-full max-w-page px-gutter md:px-gutter-md lg:px-gutter-lg', className]}
  {...rest}
>
  <slot />
</Tag>
